# Villa Camila — Variables de Entorno
# Copia este archivo como .env.local y completa los valores

# URL canónica del sitio (con protocolo, sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://villacamilasalas.es

# Google Analytics 4 — Measurement ID (formato: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager — Container ID (formato: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
